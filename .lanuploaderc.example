# LAN Uploader Configuration File
# Copy to ~/.lanuploaderc to use
#
# Configuration priority:
#   1. Command line arguments (highest)
#   2. Environment variables
#   3. This config file
#   4. Hardcoded defaults (lowest)

[lanuploader]
# Upload root directory (default: ./uploads)
UPLOAD_ROOT = ./uploads

# Maximum upload size in MB (default: 1024)
MAX_CONTENT_LENGTH_MB = 1024

# Server port (default: 8080)
PORT = 8080

# Host to bind to (default: 0.0.0.0)
# Use 0.0.0.0 to accept connections from any network interface (LAN access)
# Use 127.0.0.1 to only accept connections from localhost (local testing)
HOST = 0.0.0.0
