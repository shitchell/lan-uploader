#!/usr/bin/env bash
#
# Pre-commit hook to enforce version updates when app code changes.
# This hook checks if any of the following are modified:
# - app.py
# - static/js/*.js
# - static/style.css
# - templates/*.html
#
# If these files are changed but app.py's __version__ is NOT changed,
# the commit is rejected with a reminder to update the version.

set -euo pipefail

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

# Check if any app code files are staged
APP_CODE_CHANGED=false
VERSION_CHANGED=false

for file in $STAGED_FILES; do
  case "$file" in
    app.py)
      # Check if __version__ line is changed
      if git diff --cached app.py | grep -q '^[+-]__version__'; then
        VERSION_CHANGED=true
      fi
      APP_CODE_CHANGED=true
      ;;
    static/js/*.js|static/style.css|templates/*.html)
      APP_CODE_CHANGED=true
      ;;
  esac
done

# If app code changed but version didn't, warn (but don't block)
if [ "$APP_CODE_CHANGED" = true ] && [ "$VERSION_CHANGED" = false ]; then
  echo ""
  echo "WARNING: App code was modified but __version__ was not updated."
  echo "Consider updating __version__ in app.py and adding a changelog entry."
  echo ""
  echo "To update version:"
  echo "  1. Edit app.py and change __version__"
  echo "  2. Create/update changelogs/<version>.md"
  echo ""
  echo "Proceeding with commit..."
  echo ""
fi

exit 0
